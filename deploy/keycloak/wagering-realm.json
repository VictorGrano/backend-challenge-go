{
  "realm": "wagering",
  "enabled": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "provider", "description": "Provedor de jogos: envia e consulta apenas as próprias transações" },
      { "name": "internal", "description": "Serviço interno: carteiras, ledger, reconciliação e consulta de qualquer transação" }
    ]
  },
  "clients": [
    {
      "clientId": "wagering-api",
      "name": "API de apostas (audiência dos tokens)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false
    },
    {
      "clientId": "provider-a",
      "enabled": true,
      "publicClient": false,
      "secret": "provider-a-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "wagering-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "wagering-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-a",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "provider-b",
      "enabled": true,
      "publicClient": false,
      "secret": "provider-b-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "wagering-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "wagering-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-b",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "provider-short-lived",
      "description": "Provedor de teste com token de 2 segundos, para exercitar a expiração",
      "enabled": true,
      "publicClient": false,
      "secret": "provider-short-lived-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "access.token.lifespan": "2"
      },
      "protocolMappers": [
        {
          "name": "wagering-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "wagering-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-short-lived",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "wallet-service",
      "description": "Serviço interno que opera as carteiras",
      "enabled": true,
      "publicClient": false,
      "secret": "wallet-service-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "wagering-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "wagering-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "other-audience",
      "description": "Cliente de teste sem a audiência da API: seus tokens devem ser recusados",
      "enabled": true,
      "publicClient": false,
      "secret": "other-audience-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "service-account-provider-a",
      "enabled": true,
      "serviceAccountClientId": "provider-a",
      "realmRoles": ["provider"]
    },
    {
      "username": "service-account-provider-b",
      "enabled": true,
      "serviceAccountClientId": "provider-b",
      "realmRoles": ["provider"]
    },
    {
      "username": "service-account-provider-short-lived",
      "enabled": true,
      "serviceAccountClientId": "provider-short-lived",
      "realmRoles": ["provider"]
    },
    {
      "username": "service-account-wallet-service",
      "enabled": true,
      "serviceAccountClientId": "wallet-service",
      "realmRoles": ["internal"]
    },
    {
      "username": "service-account-other-audience",
      "enabled": true,
      "serviceAccountClientId": "other-audience",
      "realmRoles": ["provider"]
    }
  ]
}
